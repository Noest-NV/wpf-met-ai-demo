<Window x:Class="AI_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AI_WPF"
        mc:Ignorable="d"
        Title="Mechastore" Height="720" Width="1180"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left navigation rail -->
        <Border Grid.Column="0" Background="{StaticResource SideNavBrush}">
            <StackPanel>
                <TextBlock Text="Mechastore"
                           Foreground="{StaticResource SideNavTextBrush}"
                           FontSize="22" FontWeight="Bold"
                           Margin="20,24,20,24"/>
                <Button Content="Catalogue"  Style="{StaticResource NavButton}" Command="{Binding ShowCatalogueCommand}"/>
                <Button Content="Sales"      Style="{StaticResource NavButton}" Command="{Binding ShowSalesCommand}"/>
                <Button Content="Production" Style="{StaticResource NavButton}" Command="{Binding ShowProductionCommand}"/>
            </StackPanel>
        </Border>

        <!-- Content region -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
